<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Đăng ký Ngày Trở Về</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ============================================================
   CẤU HÌNH NẰM Ở THẺ <script> CUỐI FILE (const CONFIG = {...})
   ============================================================ */
:root{
  --page:#f9f9f7; --surface:#fcfcfb; --surface-2:#f3f2ee; --line:#e1e0d9; --axis:#c3c2b7;
  --ink:#0b0b0b; --ink-2:#52514e; --muted:#898781;
  --accent:#2a78d6; --accent-soft:#e6f0fc;
  --yes:#0ca30c; --maybe:#fab219; --no:#d03b3b; --blank:#c3c2b7;
  --on-maybe:#0b0b0b;
  --new:#fff6db;
  --radius:12px;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --page:#0d0d0d; --surface:#1a1a19; --surface-2:#232321; --line:#2c2c2a; --axis:#383835;
    --ink:#f0efec; --ink-2:#c3c2b7; --muted:#898781;
    --accent:#3987e5; --accent-soft:#16263b;
    --blank:#4a4a46; --new:#3a3112;
  }
}
:root[data-theme="dark"]{
  --page:#0d0d0d; --surface:#1a1a19; --surface-2:#232321; --line:#2c2c2a; --axis:#383835;
  --ink:#f0efec; --ink-2:#c3c2b7; --muted:#898781;
  --accent:#3987e5; --accent-soft:#16263b;
  --blank:#4a4a46; --new:#3a3112;
}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--page);color:var(--ink);font:15px/1.5 "Be Vietnam Pro",system-ui,-apple-system,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}
.wrap{max-width:1200px;margin:0 auto;padding:28px 16px 48px}
header{display:flex;flex-wrap:wrap;gap:16px;align-items:flex-end;justify-content:space-between;margin-bottom:24px}
.eyebrow{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600;margin:0 0 4px}
h1{font-size:26px;line-height:1.2;margin:0;font-weight:700;letter-spacing:-.01em}
.sub{color:var(--ink-2);margin:6px 0 0;font-size:14px}
.live{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.pill{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border-radius:999px;background:var(--surface);border:1px solid var(--line);font-size:13px;color:var(--ink-2);white-space:nowrap}
.dot{width:8px;height:8px;border-radius:50%;background:var(--muted)}
.pill.ok .dot{background:var(--yes);box-shadow:0 0 0 0 rgba(12,163,12,.5);animation:pulse 2s infinite}
.pill.err .dot{background:var(--no)}
.pill.demo .dot{background:var(--maybe)}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(12,163,12,.45)}70%{box-shadow:0 0 0 7px rgba(12,163,12,0)}100%{box-shadow:0 0 0 0 rgba(12,163,12,0)}}
button{font:inherit;cursor:pointer}
.btn{padding:6px 14px;border-radius:999px;border:1px solid var(--line);background:var(--surface);color:var(--ink);font-size:13px;font-weight:500}
.btn:hover{border-color:var(--axis)}
.btn:disabled{opacity:.5;cursor:default}
.banner{background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--maybe);border-radius:8px;padding:10px 14px;margin-bottom:20px;font-size:14px;color:var(--ink-2)}
.banner.err{border-left-color:var(--no)}
.banner[hidden]{display:none}

.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px}
.kpi{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px}
.kpi .label{font-size:13px;color:var(--ink-2);margin:0 0 6px;display:flex;align-items:center;gap:8px}
.kpi .value{font-size:34px;font-weight:700;line-height:1;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.kpi .note{font-size:12px;color:var(--muted);margin-top:8px}
.sw{width:10px;height:10px;border-radius:3px;display:inline-block;flex:none}

.grid2{display:grid;grid-template-columns:1.1fr .9fr;gap:12px;margin-bottom:16px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:18px}
.card h2{font-size:15px;margin:0 0 2px;font-weight:600}
.card .hint{font-size:12.5px;color:var(--muted);margin:0 0 16px}

/* stacked status bars */
.srow{margin-bottom:18px}
.srow:last-of-type{margin-bottom:12px}
.srow .t{display:flex;justify-content:space-between;font-size:13.5px;margin-bottom:6px}
.srow .t b{font-weight:600}
.srow .t span{color:var(--muted);font-variant-numeric:tabular-nums}
.stack{display:flex;gap:2px;height:28px;border-radius:6px;overflow:hidden;background:var(--surface-2)}
.seg{height:100%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;color:#fff;min-width:0;transition:flex-grow .5s ease;position:relative}
.seg.maybe{color:var(--on-maybe)}
.legend{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:12.5px;color:var(--ink-2)}
.legend span{display:inline-flex;align-items:center;gap:6px}

/* province bars */
.hbar{display:grid;grid-template-columns:minmax(90px,38%) 1fr;gap:6px 12px;align-items:center}
.hbar .lab{font-size:13px;color:var(--ink-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hbar .track{display:flex;align-items:center;gap:8px;height:22px}
.hbar .bar{height:16px;background:var(--accent);border-radius:0 4px 4px 0;min-width:2px;transition:width .5s ease}
.hbar .num{font-size:12.5px;color:var(--ink-2);font-variant-numeric:tabular-nums}
.hbar .row{display:contents}
.empty{color:var(--muted);font-size:13px}

#tip{position:fixed;pointer-events:none;background:var(--ink);color:var(--surface);font-size:12.5px;padding:6px 10px;border-radius:6px;opacity:0;transition:opacity .12s;z-index:10;white-space:nowrap}

/* table */
.tools{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:12px}
.tools input,.tools select{font:inherit;font-size:13.5px;padding:7px 12px;border:1px solid var(--line);border-radius:8px;background:var(--page);color:var(--ink)}
.tools input{flex:1 1 220px;min-width:0}
.tools .count{font-size:13px;color:var(--muted);margin-left:auto}
.tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:8px}
table{border-collapse:collapse;width:100%;font-size:13.5px}
th,td{text-align:left;padding:9px 12px;border-bottom:1px solid var(--line);vertical-align:top}
th{background:var(--surface-2);font-weight:600;font-size:12.5px;color:var(--ink-2);white-space:nowrap;position:sticky;top:0;cursor:pointer;user-select:none}
th .arr{color:var(--muted);font-size:10px;margin-left:4px}
tbody tr:last-child td{border-bottom:none}
tbody tr:hover td{background:var(--surface-2)}
tr.fresh td{animation:fresh 4s ease-out}
@keyframes fresh{0%,40%{background:var(--new)}100%{background:transparent}}
td.nw{white-space:nowrap}
td{min-width:90px}
td.c-donvi,td.c-gv{min-width:190px}
td.c-khoa,td.c-lop{min-width:110px}
td a{color:var(--accent);text-decoration:none}
td a:hover{text-decoration:underline}
.tag{display:inline-flex;align-items:center;gap:6px;white-space:nowrap;font-size:12.5px}
.muted{color:var(--muted)}
footer{margin-top:20px;font-size:12px;color:var(--muted)}

@media (max-width:860px){
  .kpis{grid-template-columns:repeat(2,1fr)}
  .grid2{grid-template-columns:1fr}
}
@media (max-width:420px){
  h1{font-size:22px}
  .kpi .value{font-size:28px}
}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div>
      <p class="eyebrow">Ban tổ chức · Lễ kỷ niệm 06/12</p>
      <h1>Đăng ký tham dự Ngày Trở Về</h1>
      <p class="sub">Tổng hợp trực tiếp từ câu trả lời biểu mẫu</p>
    </div>
    <div class="live">
      <span class="pill" id="status"><span class="dot"></span><span id="statusText">Đang tải…</span></span>
      <button class="btn" id="refresh">Tải lại</button>
