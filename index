  <div class="banner" id="banner" hidden></div>

  <section class="kpis">
    <div class="kpi"><p class="label">Tổng lượt đăng ký</p><div class="value" id="kTotal">–</div><div class="note" id="kTotalNote">&nbsp;</div></div>
    <div class="kpi"><p class="label"><i class="sw" style="background:var(--yes)"></i>Tham dự lễ</p><div class="value" id="kLe">–</div><div class="note" id="kLeNote">&nbsp;</div></div>
    <div class="kpi"><p class="label"><i class="sw" style="background:var(--yes)"></i>Tham dự tiệc</p><div class="value" id="kTiec">–</div><div class="note" id="kTiecNote">&nbsp;</div></div>
    <div class="kpi"><p class="label"><i class="sw" style="background:var(--maybe)"></i>Chưa xác định</p><div class="value" id="kMaybe">–</div><div class="note">ở lễ hoặc tiệc</div></div>
  </section>

  <section class="grid2">
    <div class="card">
      <h2>Tình trạng xác nhận</h2>
      <p class="hint">Số người theo từng câu trả lời</p>
      <div class="srow"><div class="t"><b>Lễ kỷ niệm (06/12)</b><span id="leTotal"></span></div><div class="stack" id="stackLe"></div></div>
      <div class="srow"><div class="t"><b>Tiệc giao lưu sau lễ</b><span id="tiecTotal"></span></div><div class="stack" id="stackTiec"></div></div>
      <div class="legend" id="legend"></div>
    </div>
    <div class="card">
      <h2>Nơi công tác</h2>
